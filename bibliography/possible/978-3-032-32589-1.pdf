he joint behavior of the minimum relates to the individual probabilities of X and Y exceeding t.␀)/K 32/P 43700 0 R/Pg 751 0 R/S/Figure/Type/StructElem>>endobj43815 0 obj<</K[33 44038 0 R]/P 43700 0 R/Pg 751 0 R/S/Caption/Type/StructElem>>endobj43816 0 obj<</K[38 44036 0 R 41 44037 0 R 44]/P 43700 0 R/Pg 751 0 R/S/P/Type/StructElem>>endobj43817 0 obj<</K[45 44034 0 R 48 44035 0 R 51]/P 43700 0 R/Pg 751 0 R/S/P/Type/StructElem>>endobj43818 0 obj<</K[52 44032 0 R 54]/P 43700 0 R/Pg 751 0 R/S/P/Type/StructElem>>endobj43819 0 obj<</K[55 44028 0 R 58 44029 0 R 61 44030 0 R 64 44031 0 R 67]/P 43700 0 R/Pg 751 0 R/S/P/Type/StructElem>>endobj43820 0 obj<</K[68 44009 0 R 70 44010 0 R 72 44011 0 R 74 44012 0 R 76 44013 0 R 79 44014 0 R 81 44015 0 R 84 44016 0 R 86 44017 0 R 89 44018 0 R 92 44019 0 R 95 44020 0 R 98 44021 0 R 101]/P 43700 0 R/Pg 751 0 R/S/P/Type/StructElem>>endobj43821 0 obj<</K[102 44002 0 R 105 44003 0 R 108 44004 0 R 111 44005 0 R 114 44006 0 R 117 44007 0 R 120 44008 0 R 123]/P 43700 0 R/Pg 751 0 R/S/P/Type/StructElem>>endobj43822 0 obj<</K[2 43996 0 R 4 43997 0 R 6 43998 0 R 8]/P 43700 0 R/Pg 754 0 R/S/P/Type/StructElem>>endobj43823 0 obj<</K[9 43991 0 R 11 43992 0 R 14 43993 0 R 16]/P 43700 0 R/Pg 754 0 R/S/P/Type/StructElem>>endobj43824 0 obj<</K[17 43977 0 R 20 43978 0 R 23 43979 0 R 26 43980 0 R 29 43981 0 R 32 43982 0 R 35 43983 0 R 38 43984 0 R 41 43985 0 R 44 43986 0 R 47 43987 0 R 50 43988 0 R 53 43989 0 R 55]/P 43700 0 R/Pg 754 0 R/S/P/Type/StructElem>>endobj43825 0 obj<</K 57/P 43700 0 R/Pg 754 0 R/S/H2/Type/StructElem>>endobj43826 0 obj<</K[59 43964 0 R 61 43965 0 R 64 43966 0 R 67 43967 0 R 70 43968 0 R 73 43969 0 R 76 43970 0 R 79 43971 0 R 82 43972 0 R 85 43973 0 R 87 43974 0 R 90]/P 43700 0 R/Pg 754 0 R/S/P/Type/StructElem>>endobj43827 0 obj<</K[91 43961 0 R 93 43962 0 R 96]/P 43700 0 R/Pg 754 0 R/S/P/Type/StructElem>>endobj43828 0 obj<</K[97 43959 0 R 100 43960 0 R 103]/P 43700 0 R/Pg 754 0 R/S/P/T