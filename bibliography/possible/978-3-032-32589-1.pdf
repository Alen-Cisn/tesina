e/StructElem>>endobj38791 0 obj<</K 8/P 38701 0 R/Pg 1195 0 R/S/H3/Type/StructElem>>endobj38792 0 obj<</K 10/P 38701 0 R/Pg 1195 0 R/S/P/Type/StructElem>>endobj38793 0 obj<</K 11/P 38701 0 R/Pg 1195 0 R/S/P/Type/StructElem>>endobj38794 0 obj<</K[12 39117 0 R 14 39118 0 R 16 39119 0 R 18 39120 0 R 20]/P 38701 0 R/Pg 1195 0 R/S/P/Type/StructElem>>endobj38795 0 obj<</A 39116 0 R/Alt(IIV Visualization of the Kripke model in Figure 3. On the left side of this figure is a graph theoretical representation of the possible world infrastructure of the Kripke model. The three possible worlds w1, w2 and w3 are depicted as green circles of the\ same name. The green circles w2 and w3 have a black outline while the green cirlce w1 has a red outline over which a black computer pointer icon hovers. There are outgoing arrows from w1 to itself and to w2, ourgoing arrows from w2 to itself and to w3, a\nd one outgoing arrow from w3 to w2. These arrows represent the accessibilities between the worlds as described by the accessibility relation in the Kripke model. On the right side of this figure, a visualization of the Tarskian interpretation in world w1\ is shown. This constitutes of three graph theoretical graphs. Each graph has a root, meaning a node that only has outgoing arrows, which is placed on the top of each graph. Each graph also has one leaf, meaning a node with only incoming arrows, which is \placed at the very bottom of the graph. Roots and leaves have a triangular shape. The leftmost graph of these three has the root named \\$o that has four outgoing arrows. Following the arrows from root to leaf, the leftmost path consists of four nodes, na\mely the root \\$o, a pentagonical shaped node named rains, a rectangular shaped node named \\$true, and finally the leaf also named \\$o. The next path at the right from this consists of 5 nodes, namely the root,  a pentagonical node named peaceful, an o\val node child\\_1, the same node \\$true as before, and the leaf. The thrid path consists of five nodes, namely the root, a pentagonical node named quiet, a second oval node also named child\\_1, a rectangular shaped node named \\$false, and the leaf. Th\e last path consists of five nodes, namely the root, a pentagonical node named sleepy, an oval node named adult\\_1, a rectangular node named \\$false, and the leaf. The second graph consists of only four nodes in one straig␀)/K 21/P 38701 0 R/Pg 1195 0 R/S/Figure/Type/StructElem>>endobj38796 0 obj<</K[22 39114 0 R 24]/P 38701 0 R/Pg 1195 0 R/S/Caption/Type/StructElem>>endobj38797 0 obj<</K 26/P 38701 0 R/Pg 1195 0 R/S/P/Type/StructElem>>endobj38798 0 obj<</K[1 39110 0 R 4 39111 0 R 7 39112 0 R 10 39113 0 R 13]/P 38701 0 R/Pg 1199 0 R/S/P/Type/StructElem>>endobj38799 0 obj<</K 15/P 38701 0 R/Pg 1199 0 R/S/H2/Type/StructElem>>endobj38800 0 obj<</K 18/P 38701 0 R/Pg 1199 0 R/S/H3/Type/StructElem>>endobj38801 0 obj<</K[20 39105 0 R 39106 0 R 23]/P 38701 0 R/Pg 1199 0 R/S/P/Type/StructElem>>endobj38802 0 obj<</K[39090 0 R 39091 0 R 39092 0 R]/P 38701 0 R/S/L/Type/StructElem>>endobj38803 0 obj<</K[34 39088 0 R 36]/P 38701 0 R/Pg 1199 0 R/S/P/Type/StructElem>>endobj38804 0 obj<</K 37/P 38701 0 R/Pg 1199 0 R/S/P/Type/StructElem>>endobj38805 0 obj<</K 38/P 38701 0 R/Pg 1199 0 R/S/H3/Type/StructElem>>endobj38806 0 obj<</K[40 39084 0 R 42 39085 0 R 44]/P 38701 0 R/Pg 1199 0 R/S/P/Type/StructElem>>endobj38807 0 obj<</K[39009 0 R 39010 0 R 39011 0 R]/P 38701 0 R/S/Table/Type/StructElem>>endobj38808 0 obj<</K[38945 0 R 38946 0 R 38947 0 R]/P 38701 0 R/S/Table/Type/StructElem>>endobj38809 0 obj<</K[123 38943 0 R 125]/P 38701 0 R/Pg 1202 0 R/S/P/Type/StructElem>>endobj38810 0 obj<</K[126 38937 0 R 128 38938 0 R 130 38939 0 R 132]/P 38701 0 R/Pg 1202 0 R/S/P/Type/StructElem>>endobj38811 0 obj<</K 133/P 38701 0 R/Pg 1202 0 R/S/P/Type/StructElem>>endobj38812 0 obj<</K 134/P 38701 0 R/Pg 1202 0 R/S/P/Type/StructElem>>endobj38813 0 obj<</K